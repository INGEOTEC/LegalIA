# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/

# Output generated by dof2md (downloaded PDFs and Markdown)
packages/dof2md/output/

# Scratch output from the daily DOF archive job (only the .md ends up in a release)
/dof-output/
/produced_files.txt

# Local archive downloaded by `dofjson --archivo` (local only, never committed)
/notas-archivo/

# Local output from nota2md / dofjson / ad-hoc runs (generated Markdown, PDFs, images)
/output/

# Titles dataset downloaded by dofjson.titulos.download_legal_provisions_titles when rendering
# the DOF Titles page (local only, never committed)
/website/explorations/titulos.jsonl.gz
/website/explorations/organigrama.json

# Legislative history built by `leyesmx` (local only). It lives solely in the
# historial-legislativo release; see leyesmx.historial.descarga_historial.
/packages/leyesmx/data/

# Editor / OS
.DS_Store

# Local Claude Code settings (not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

/.quarto/
**/*.quarto_ipynb
scripts/legal_provisions/
scripts/scjn/
scripts/titulos.json.gz
scripts/organigrama.json
