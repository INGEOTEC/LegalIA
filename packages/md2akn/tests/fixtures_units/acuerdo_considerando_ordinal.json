    },
    {
      "unit_type": "article",
      "eId": "art_SEGUNDO",
      "piece": 0,
      "piece_eId": null,
      "akn_type": "article",
      "num": "SEGUNDO",
      "path": [],
      "text": "**SEGUNDO.-** Los lineamientos se publicarán en el Diario Oficial.",
