      "eId": "art_PRIMERO",
      "piece": 0,
      "piece_eId": null,
      "akn_type": "article",
      "num": "PRIMERO",
      "path": [],
      "text": "**PRIMERO.-** Se emiten los lineamientos para la operación.",
